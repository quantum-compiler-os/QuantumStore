# --- Browser (exposed to the client, never put secrets here) ---
# Backend origin (no trailing slash, no /api). Leave empty in dev to use the Vite proxy to :5000.
VITE_API_URL=
# Where the storefront lives (used by the "View store" link)
VITE_STORE_URL=http://127.0.0.1:5173

# --- Server-only (Vercel functions in api/) ---
# Daraz Open Platform app credentials (https://open.daraz.com -> App Console)
DARAZ_APP_KEY=
DARAZ_APP_SECRET=
# Must be registered as a callback URL in the Daraz app console
DARAZ_REDIRECT_URI=http://127.0.0.1:5174/launcher-api/daraz/callback
# Seller-region REST host (Pakistan)
DARAZ_API_HOST=https://api.daraz.pk
# Same Atlas database the backend uses (stores the Daraz tokens + listing map)
MONGODB_URI=
# QuantumStore backend origin, used to verify the signed-in owner
QUANTUM_API_URL=http://127.0.0.1:5000
